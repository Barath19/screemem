# ---------------------------------------------------------------------------
# The one value you must fill in
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5

# ---------------------------------------------------------------------------
# Embeddings — local, no key, no network.
# Do not delete these three lines. cognee's embedding config defaults to OpenAI
# and falls back to LLM_API_KEY as the embedding key, so with an Anthropic key
# you get "Incorrect API key provided: sk-ant-..." *from OpenAI*, which is a
# baffling error to debug. fastembed runs locally. Its default model name is
# still an OpenAI one, hence naming a model fastembed actually ships.
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# ---------------------------------------------------------------------------
# Vector store: Qdrant.
#   local:  docker run -p 6333:6333 qdrant/qdrant
#   cloud:  https://cloud.qdrant.io — free tier, paste cluster URL + API key
# ---------------------------------------------------------------------------
VECTOR_DB_PROVIDER=qdrant
VECTOR_DATASET_DATABASE_HANDLER=qdrant
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_KEY=

# Qdrant's dataset handler does not support cognee's per-user multi-tenant mode.
# This project uses one shared dataset, so turn that mode off. Leaving it on
# produces permission errors that read like adapter bugs.
ENABLE_BACKEND_ACCESS_CONTROL=false

# Skip the extra session-turn LLM call on every query. Saves ~1800 prompt
# tokens and a round trip per question; we do not need conversational memory.
AUTO_FEEDBACK=false

# ---------------------------------------------------------------------------
# Slack — fill in after creating the app (step 3 in the README)
# ---------------------------------------------------------------------------
SLACK_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Rate limiting. Gemini's free tier allows 5 requests/minute per model, and
# cognee's auto-throttle guesses 60/min, so without these it fires ~12x too
# fast and every cognify chunk burns its retry budget on 429s.
# Raise these if you move to a paid key — ingest time scales directly with them.
# ---------------------------------------------------------------------------
LLM_RATE_LIMIT_ENABLED=true
LLM_RATE_LIMIT_REQUESTS=4
LLM_RATE_LIMIT_INTERVAL=60

# Sessions OFF. With CACHING=true (the default) cognee stores each Q&A turn and
# vector-recalls prior turns into later prompts. That makes the same question
# answered twice give different answers, and it leaks a previous unscoped answer
# into a later source-scoped one -- which destroys the scoped/unscoped contrast
# this whole demo rests on.
CACHING=false

# Quiet cognee structlog output so demo terminal output is readable.
LOG_LEVEL=ERROR

# Cognee Cloud — optional, only for the "add to cognee cloud" push step.
COGNEE_SERVICE_URL=
COGNEE_API_KEY=
